{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "summary",
    "evidence"
  ],
  "properties": {
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "object"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "agent_id",
    "task_id",
    "mode",
    "issue_id"
  ],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "read_only",
        "writer"
      ]
    },
    "issue_id": {
      "type": "string"
    }
  }
}

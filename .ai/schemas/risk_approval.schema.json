{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "approver_agent_id",
    "source_run_id",
    "risk_level",
    "rationale"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "approver_agent_id": {
      "const": "risk-approval-agent"
    },
    "source_run_id": {
      "type": "string"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
